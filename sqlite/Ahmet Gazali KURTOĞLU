import sqlite3

baglanti = sqlite3.connect("okul.db")
imlec = baglanti.cursor()

imlec.execute(
    "CREATE TABLE IF NOT EXISTS ogrenciler (id INTEGER PRIMARY KEY, ad TEXT)"
)
baglanti.commit()

while True:
    print("1- Öğrenci Ekle")
    print("2- Öğrencileri Listele")
    print("3- Çıkış")
    
    secim = input("Seçim: ")
    
    if secim == "1":
        ad = input("Öğrenci adı: ")
        
        imlec.execute(
            "INSERT INTO ogrenciler (ad) VALUES (?)",
            [ad]
        )
        
        baglanti.commit()
        
    elif secim == "2":
        imlec.execute("SELECT * FROM ogrenciler")
        
        veriler = imlec.fetchall()
        
        for satir in veriler:
            print(satir)
            
    elif secim == "3":
        break
    
baglanti.close()
